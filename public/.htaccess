# =======================================================================
# Bengal Cyber - Production Apache / cPanel / LiteSpeed Configuration
# Optimized for maximum speed, Brotli/Gzip compression, and security
# =======================================================================

RewriteEngine On

# 1. Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# 2. Allow LiteSpeed to serve static Next.js assets without blocking _next
<IfModule litespeed>
  AllowBlockedUrl on
</IfModule>

# 3. Handle directory slash and fallback
DirectorySlash On
DirectoryIndex index.html

# 4. Custom 404 Error page
ErrorDocument 404 /404.html

# 5. Disable Directory Browsing (Prevents directory listing)
Options -Indexes

# 6. Block direct access to hidden files and sensitive backend files
<FilesMatch "(\.(git|env|bak|log|sql|zip|tar|gz|config)|composer\.|package(-lock)?\.json|tsconfig\.json|README\.md)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

# 7. Security & Performance Headers
<IfModule mod_headers.c>
  Header unset X-Powered-By
  Header unset Server
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set X-XSS-Protection "1; mode=block"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Connection "keep-alive"

  # Static Assets Caching (1 Year Immutable)
  <FilesMatch "\.(js|css|woff2|woff|ttf|eot|png|jpe?g|webp|avif|svg|ico|mp4|webm)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>

  # HTML files revalidate to always serve fresh content
  <FilesMatch "\.(html|htm)$">
    Header set Cache-Control "max-age=0, no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>
</IfModule>

# 8. Enable Brotli Compression (High performance compression)
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml application/x-javascript
</IfModule>

# 9. Enable Gzip / Deflate Compression (Fallback & standard)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml application/x-javascript
</IfModule>

# 10. Browser Caching for static assets (Expires Headers)
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/gif "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/x-javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType video/webm "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
